#!/usr/bin/env bash
# pod-down — delete the CubeStack bootstrap installer pod.
#
# The pod is deploy tooling only: once the cluster is verified the pod has no
# ongoing role, and leaving it running wastes a node's ~483MB image plus the
# pod's resources. But until the cluster IS verified the pod is where the deploy
# log lives, and it holds the only copy of admin.conf — deleting it early destroys
# the evidence needed to diagnose and recover.
#
# That rule is mechanical here rather than prose: without a verify-ok stamp in
# the run dir this refuses (E_POD_DELETE_UNSAFE), and --force is the deliberate
# override. The same gate applies to Step 7's operator-ok stamp on a run that
# installs the platform: the pod is the only host that can reach the deployed
# cluster, so deleting it early ends the run's ability to retry the operator
# install at all. The delete is idempotent — "already gone" is a success, not an
# error.
#
# admin.conf is rescued into the run dir (mode 600 — it holds a cluster-admin
# key) before the pod goes, and named in the verdict as `kubeconfig=`. The deploy
# log is not: it is unbounded and can echo credentials.
#
# The pod's /tmp/cubestack-values.conf holds live credentials, so it is shredded
# before the pod goes away.
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/verdict.sh
. "$SELF_DIR/lib/verdict.sh"
# shellcheck source=lib/common.sh
. "$SELF_DIR/lib/common.sh"
cs_init

usage() {
  cat <<'USAGE'
pod-down [options]
  --run ID     the run being cleaned up (default: this run's id)
  --pod NAME   delete this pod (default: this run's, <prefix>-<run-id>)
  --force      delete without a verify-ok stamp (the cluster was not verified),
               and without an operator-ok stamp when the run has Step 7 on
  -h, --help   this text
USAGE
}

POD_OPT=""
FORCE=0

while [ $# -gt 0 ]; do
  case "$1" in
    --run) cs_need_val "$@";   cs_run_opt "${2:-}"; shift 2 ;;
    --pod) cs_need_val "$@";   POD_OPT="${2:-}"; shift 2 ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage; cs_ok "help=1" ;;
    *) cs_usage_fail "unknown argument: $1" ;;
  esac
done

# The safety gate runs before anything touches the cluster: it is a local file
# check, and "never delete the pod before the cluster is verified" must hold even
# when the cluster is unreachable.
if [ "$FORCE" != 1 ] && [ -z "$(cs_stamp_read verify-ok)" ]; then
  cs_fail E_POD_DELETE_UNSAFE recover=rerun:verify \
    hint="no verify-ok stamp in the run dir; the pod still holds the deploy log and admin.conf (use --force to delete anyway)"
fi

# Step 7's platform install runs from this pod too, and pod-down is what makes it
# impossible to retry: once the pod is gone, `operator-up` and `operator-wait`
# have no host left that can reach the deployed cluster at all. So a run that had
# Step 7 ON must have finished it — an operator-ok stamp — before the pod goes.
#
# Read from run.env, not guessed: a run configured with --no-operator has no
# platform step to wait for and must still end normally. Absent (a run dir older
# than this key) means OFF, so an old run is never blocked by a step it never had.
if [ "$FORCE" != 1 ] && [ "$(cs_run_env_get OPERATOR_ENABLED)" = "1" ] \
   && [ -z "$(cs_stamp_read operator-ok)" ]; then
  cs_fail E_POD_DELETE_UNSAFE recover="rerun:operator-wait" \
    hint="this run installs the platform operator but has no operator-ok stamp; the pod is the only host that can reach the deployed cluster, so deleting it now makes operator-up and operator-wait unrecoverable (use --force to delete anyway)"
fi

# The kubeconfig guard, and then the budget. Both sit BELOW the two safety gates
# above: those are local file checks that must hold even when the cluster cannot
# be reached. Above the budget for reserve-vips' reason — spending an attempt on
# a host that cannot answer would make the budget meaningless, and an unreachable
# KUBECONFIG is a host environment error, not a failure of this step.
cs_kubeconfig_guard
cs_budget_guard

# A missing run id is a usage error, NOT "nothing to delete". Reporting
# `already=1` for it would be a success verdict for a cleanup that never
# identified a pod — the one shape of wrong answer this contract exists to
# prevent. "The pod is already gone" is a different case, checked below.
if [ -n "$POD_OPT" ]; then
  TARGET="$POD_OPT"
else
  TARGET="$(cs_pod_resolve "")" || cs_usage_fail \
    "no run id — pass --run <run-id> (preflight prints it as run=) or --pod <name>"
fi

# The local copy of the values file is a credential; it goes away either way.
rm -f "$(cs_run_dir)/values.conf" 2>/dev/null || true

# Where the cluster's kubeconfig is rescued to (see the section below). Initialised
# here so the already-gone path can report it too.
KCONF_DEST="$(cs_run_dir)/admin.conf"
KCONF_REPORT=""

if ! kubectl -n "$CS_NS" get pod "$TARGET" >/dev/null 2>&1; then
  cs_note "pod $TARGET is already gone"
  # Nothing to rescue from - but say whether a kubeconfig survives, because "the
  # pod is gone and so is the cluster's only handle" is the outcome worth
  # knowing, and it is otherwise indistinguishable from a clean re-run.
  if [ -f "$KCONF_DEST" ]; then
    KCONF_REPORT="$KCONF_DEST"
  else
    cs_note "no rescued kubeconfig at $KCONF_DEST; the deployed cluster is no longer reachable from this host"
  fi
  set -- "pod=$TARGET" "deleted=0" "already=1"
  [ -n "$KCONF_REPORT" ] && set -- "$@" "kubeconfig=$KCONF_REPORT"
  cs_ok "$@"
fi

# --- rescue the deployed cluster's kubeconfig ---------------------------------
# admin.conf is the only handle that exists on the cluster this run built, and it
# lives only in this pod. Deleting the pod destroys the cluster's reachability for
# good: nothing else on this host can talk to the box, and no later step can be
# retried against it. So it is copied into the run dir first.
#
# It is a CREDENTIAL, not a convenience file - it carries a client certificate and
# its private key, and that principal is cluster-admin. Two consequences, both
# deliberate:
#   * it is created 600 by running the capture under a `umask`, not created
#     world-readable and chmod-ed afterwards, which would leave the key readable
#     for the life of the copy;
#   * it is only kept once it validates as a kubeconfig. A failed exec must not
#     leave behind a file that is really kubectl's error text but passes for a
#     kubeconfig by existing.
#
# cs_pod_exec_out (not cs_pod_exec) is load-bearing here: cs_pod_exec folds stderr
# into stdout, so any kubectl complaint would be written INTO the kubeconfig.
#
# The deploy log is deliberately NOT rescued: it is unbounded, and its ansible
# output can echo credentials. The pod's own copy is shredded below.
if cs_pod_ready "$TARGET"; then
  cs_run_mkdir
  KCONF_TMP="$(cs_run_dir)/.admin.conf.tmp.$$"
  # Redirect inside the backgrounded child, so a signal's verdict still reaches
  # stderr rather than the capture file (diagnose's reason, same shape).
  kconf_capture() { "$@" > "$KCONF_TMP"; }
  ( umask 077
    cs_wait_cmd kconf_capture cs_pod_exec_out "$TARGET" cat "$CS_KCONF"
  ) 2>/dev/null || true
  if [ -s "$KCONF_TMP" ] && grep -q '^apiVersion:' "$KCONF_TMP" \
     && grep -q '^clusters:' "$KCONF_TMP"; then
    chmod 600 "$KCONF_TMP" 2>/dev/null || true
    if mv -f "$KCONF_TMP" "$KCONF_DEST" 2>/dev/null; then
      KCONF_REPORT="$KCONF_DEST"
      cs_note "rescued the deployed cluster's kubeconfig to $KCONF_DEST (mode 600, holds a cluster-admin key)"
    else
      rm -f "$KCONF_TMP" 2>/dev/null || true
      cs_note "could not write $KCONF_DEST; the kubeconfig will be lost with the pod"
    fi
  else
    rm -f "$KCONF_TMP" 2>/dev/null || true
    cs_note "no kubeconfig at $CS_KCONF in the pod (or it did not validate); nothing rescued"
  fi
else
  cs_note "pod $TARGET is not Ready; the kubeconfig could not be rescued and is lost with the pod"
fi

# Shred the credentials the config and fetch steps left behind, then remove each
# file regardless of whether the filesystem supports shred.
#
# A glob, because those steps name their copy /tmp/cubestack-values.<script>.conf
# so that Steps 4 and 5 can run in parallel without deleting each other's file.
# The bare path is still covered: an older script version may have left one, and
# this is the last chance to remove it before the pod goes.
#
# The Provider's external-ceph.env is here too. `configure` deliberately leaves
# it in place - the installer sources it mid-deploy - so this is the only place
# it gets removed. It holds the Provider's CSI secrets and RGW keys; deleting
# the pod without shredding it would be the one credential left behind.
#
# /tmp/cubestack-harbor.*.conf is `configure`'s staged copy of the run's Harbor
# robot password, written only when the run takes the operator's images from
# Harbor (the default). It is NOT in the values family above - it is its own
# secret file with its own name - so the glob cannot reach it and it has to be
# listed here. `configure` shreds it through its own cs_cleanup hook; this is the
# backstop for a hook that a SIGKILL never ran.
#
# /tmp/cubestack-cephfs.* is the mount-models staging directory. That step
# removes it through its own cs_cleanup hook, but a hook cannot run if the
# script is SIGKILLed - so this is the backstop, and it matters more than the
# others: the directory holds a bare CephX key in a file named `.secret`.
#
# /tmp/cubestack-operator.* is operator-up's staging directory: the Helm robot
# password, the dockerconfigjson it builds from it, and helm's registry
# config.json one level down (which is why that loop runs to two levels). Same
# hook-cannot-run rationale, same backstop role.
#
# $HOME/.config/helm/registry/config.json is a backstop for a FUTURE edit:
# operator-up exports HELM_REGISTRY_CONFIG at the staged directory precisely so
# helm does not write its credential file there, and nothing in the current
# scripts creates this path. Deleting it is harmless - the pod is about to be
# deleted anyway - and this is the last chance to remove a base64 credential
# from the pod's home if some later change forgets.
if cs_pod_ready "$TARGET"; then
  cs_logged kubectl -n "$CS_NS" exec "$TARGET" -- bash -c \
    'for f in /tmp/cubestack-values.conf /tmp/cubestack-values.*.conf \
              /tmp/cubestack-harbor.*.conf \
              /opt/cubestack-installer/deployments/config/external-ceph.env; do
       [ -f "$f" ] || continue
       shred -u "$f" 2>/dev/null || rm -f "$f"
     done
     for f in /tmp/cubestack-cephfs.*/* /tmp/cubestack-operator.*/* /tmp/cubestack-operator.*/*/*; do
       [ -f "$f" ] || continue
       shred -u "$f" 2>/dev/null || rm -f "$f"
     done
     rm -rf /tmp/cubestack-cephfs.* /tmp/cubestack-operator.* 2>/dev/null
     f="${HOME:-/root}/.config/helm/registry/config.json"
     if [ -f "$f" ]; then shred -u "$f" 2>/dev/null || rm -f "$f"; fi'
else
  cs_note "pod $TARGET is not Ready; skipping the values-file shred (deletion removes it anyway)"
fi

cs_logged kubectl -n "$CS_NS" delete pod "$TARGET" --wait=false

# Bounded confirm: --wait=false returns before the kubelet has finished
# terminating, so a bare "delete returned" is not "gone". Through cs_wait_cmd so
# a signal interrupts the wait rather than being deferred behind it, and with
# the redirect inside the backgrounded child so such a signal still reports
# E_INTERRUPTED on stderr instead of into /dev/null.
quiet() { "$@" >/dev/null 2>&1; }
cs_wait_cmd quiet kubectl -n "$CS_NS" wait --for=delete "pod/$TARGET" --timeout=60s || true

if kubectl -n "$CS_NS" get pod "$TARGET" >/dev/null 2>&1; then
  cs_note "pod $TARGET is still terminating (bounded wait expired); the delete was accepted"
fi

set -- "pod=$TARGET" "deleted=1" "already=0"
[ -n "$KCONF_REPORT" ] && set -- "$@" "kubeconfig=$KCONF_REPORT"
cs_ok "$@"
