#!/usr/bin/env bash
# configure — write cluster.conf in the installer pod from a local values file.
#
# This is the credential path, and the script owns every hazard in it:
#   validate locally  -> refuse `***` artifacts BEFORE anything crosses the wire
#   chmod 600         -> the values file never lands world-readable
#   kubectl cp        -> the ONLY sanctioned way to move a secret into the pod
#   remove on exit    -> an EXIT trap shreds the pod-side copy even on failure
#   byte-gate         -> re-read the config from disk and refuse if `***` landed
#
# The model never writes a credential with sed/echo/heredoc (the tool layer
# redacts those to `***`), never authors the rewriter (it is a repo file now),
# and never has to read the installer's config: since the 2026-10-15 split that
# is cluster.conf.example (~11 KB) plus its sibling cluster.defaults.conf, and
# the rewriter consults both to tell a relocated key from a removed one.
#
# Idempotent: an existing cluster.conf is regenerated IN PLACE. It is never
# re-copied from the example, which would wipe Ceph/MetalLB/NODES written by a
# previous attempt.
#
# --external-ceph-env additionally places the Provider's `external-ceph.env` at
# deployments/config/external-ceph.env, where the installer auto-detects and
# SOURCES it. That file is placed, not destroyed: unlike the values file it is
# read again ~12 minutes later, mid-deploy, by the Ceph module. Shredding it
# here (as the values-file cleanup does) would break the deploy it was placed
# for; pod-down owns its removal.
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/verdict.sh
. "$SELF_DIR/lib/verdict.sh"
# shellcheck source=lib/common.sh
. "$SELF_DIR/lib/common.sh"
cs_init

CONF_DIR="/opt/cubestack-installer/deployments/config"
CONF_NAME="cluster.conf"
POD_ARG=""
VALUES=""
EXT_ENV=""
# Initialised here, not at the placement block far below: the dry run reads both
# of these, and under `set -u` an unset read is fatal rather than empty.
EXT_ENV_FLAG=0
EXT_ENV_POD=""
# Same rule: HARBOR_RO is only assigned on an online run, and the dry-run report
# names it. Empty here means "no credential in play", which is the offline case.
HARBOR_RO=""
DRY_RUN=0

usage() {
  cat <<'USAGE'
configure --values <file> [--pod NAME] [--run ID] [--conf-name cluster.conf]
          [--external-ceph-env FILE]
  --values FILE   local shell-assignment file (mode 600). Every line must be
                  KEY='value' with a key from the allow-list; no `***` anywhere.
  --external-ceph-env FILE
                  the Provider's exported external-ceph.env. Placed at
                  deployments/config/external-ceph.env, hash-verified, and left
                  in place for the deploy to source. Requires CEPH_MODE in the
                  values file. With this, CEPH_MONITORS and CEPH_KEYRING are
                  NOT needed - the env file carries the credentials.
  --run ID        the run this config belongs to (default: this run's id)
  --pod NAME      installer pod (default: this run's, <prefix>-<run-id>)
  --conf-name N   config file under deployments/config/ (default cluster.conf)
  --dry-run       validate and print the resolved plan, then stop WITHOUT
                  writing cluster.conf. Use this to exercise the script against
                  a live pod: a real run rewrites the pod's config in place and
                  will clobber real credentials with whatever the values file
                  carries.

Two kinds of images can come from Harbor. The ADDON images always come from the
in-cluster registry (or straight from Harbor when the registry is off). The
cubeStack OPERATOR's own images are separate, and where they come from is decided
by `preflight --operator-images` (online by default), which this step passes
through unchanged. On an online run the operator's images are pulled by the
NODES, so this step also writes the run's Harbor robot credential into
cluster.conf as CUBESTACK_OPERATOR_HARBOR_USER/PASSWORD — the operator's image
lives in the private project suanova-private, and without it the installer warns,
clears the pull secret, and leaves an operator that never starts. The credential
is read from the path preflight recorded (HARBOR_RO_VALUES_FILE) and is moved the
same way the values file is: kubectl cp, sourced in the pod, shredded on exit.
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --values) cs_need_val "$@";    VALUES="${2:-}"; shift 2 ;;
    --run) cs_need_val "$@";       cs_run_opt "${2:-}"; shift 2 ;;
    --pod) cs_need_val "$@";       POD_ARG="${2:-}"; shift 2 ;;
    --conf-name) cs_need_val "$@"; CONF_NAME="${2:-}"; shift 2 ;;
    --external-ceph-env) cs_need_val "$@"; EXT_ENV="${2:-}"; shift 2 ;;
    --dry-run)   DRY_RUN=1; shift ;;
    -h|--help)   usage; cs_ok "help=1" ;;
    *) cs_usage_fail "unknown argument: $1" ;;
  esac
done
[ -n "$VALUES" ] || cs_usage_fail "--values is required"

# Derived HERE, after parsing: the declaration block at the top runs before the
# argument loop, so $EXT_ENV is still empty up there. Setting the flag only at
# the placement block (the first attempt) made --dry-run report ext_env=0 for a
# run that did pass an env file - a wrong answer about whether the official
# import path is engaged, in the very output meant to be trusted.
# Fall back to the path preflight recorded, so the official import path is named
# exactly once per run. Without this, forgetting the flag on this one call
# silently switches to the hand-filled path and fails on the absent
# CEPH_MONITORS - a puzzling way to be told "you omitted an argument".
if [ -z "$EXT_ENV" ]; then
  EXT_ENV="$(cs_run_env_get EXTERNAL_CEPH_ENV_FILE)"
fi
EXT_ENV_FLAG=0
[ -n "$EXT_ENV" ] && EXT_ENV_FLAG=1

cs_kubeconfig_guard

# --- local validation (before anything crosses the wire) --------------------
cs_values_lint "$VALUES" SSH_PW NODES_MASTER MINIO_EP MINIO_AK MINIO_SK

# The Provider env file is validated BEFORE the rewrite, not after. It is cheap
# and local, and a bad one must not cost a cluster.conf that was already made
# correct — the same "fail before mutating" rule the credential path follows.
#
# Deliberately NOT added to CS_VALUES_ALLOWED: that file is ours and must stay
# KEY='value'. This one is the Provider's export in Rook's own format (a
# multi-line quoted ARGS block plus bare `export KEY=value` lines), so it gets
# its own gate: cs_ceph_env_lint.
CEPH_ENV_DEST="external-ceph.env"
if [ -n "$EXT_ENV" ]; then
  cs_ceph_env_lint "$EXT_ENV"

  # An env file with no CEPH_MODE is a silent no-op: the rewriter skips the
  # whole Ceph block, the file lands, nothing imports it, and the run reports
  # success having installed no Ceph at all. That is the one failure mode here
  # that would not show up until verify.
  case " ${CS_VALUES_KEYS} " in
    *" CEPH_MODE "*) ;;
    *) cs_usage_fail "--external-ceph-env requires CEPH_MODE='external' in $VALUES; without it the Ceph block is skipped and the env file is never read" ;;
  esac
fi

# --- expose mode and pool ---------------------------------------------------
# `preflight --expose` records its answer in run.env, but the rewriter reads
# SERVICE_EXPOSE_MODE from the VALUES FILE — so until this existed the resolved
# mode never reached cluster.conf at all, and a `--expose metallb` run quietly
# deployed nodeport. The default is now metallb, which makes that gap
# load-bearing: without the injection, "load balancer is the default" would be a
# line in a doc and nothing more.
#
# Precedence is the same shape as CEPHFS/REGISTRY below: an explicit key in the
# values file always wins, and run.env only fills a gap it left. The injection is
# applied AFTER `set -a; . $POD_VALUES`, so it cannot be clobbered by the source.
#
# Resolved UP HERE, above the budget guard, and not where it is used: the pool
# check below is deterministic (it reads the local values file and run.env and
# nothing else), so it must not cost an attempt — and its recover verb is
# `rerun:reserve-vips`, which the budget would otherwise refuse to let us run.
EXPOSE_MODE=""
case " ${CS_VALUES_KEYS} " in
  *" SERVICE_EXPOSE_MODE "*) EXPOSE_MODE="$(sed -n "s/^SERVICE_EXPOSE_MODE='\([^']*\)'\$/\1/p" "$VALUES" | head -1)" ;;
esac
[ -n "$EXPOSE_MODE" ] || EXPOSE_MODE="$(cs_run_env_get EXPOSE)"
[ -n "$EXPOSE_MODE" ] || EXPOSE_MODE="metallb"

METALLB_POOL_EFF=""
case " ${CS_VALUES_KEYS} " in
  *" METALLB_POOL "*) METALLB_POOL_EFF="$(sed -n "s/^METALLB_POOL='\([^']*\)'\$/\1/p" "$VALUES" | head -1)" ;;
esac
[ -n "$METALLB_POOL_EFF" ] || METALLB_POOL_EFF="$(cs_run_env_get POOL_RANGE)"

# A metallb run with no pool must fail HERE and say why. Every other path ends
# in the rewriter's exit 11, whose message names the example's off-L2
# placeholder (10.66.1.131-10.66.1.132) — which names the symptom and not the
# cause, and points at a value no run sets any more.
#
# The pool is not a Step 0 answer any more: it is the block Step 1b
# (reserve-vips) CLAIMS from the host's cubestack-ipam, so the only real cause of
# an empty pool is that Step 1b has not run for this run id.
if [ "$EXPOSE_MODE" != "nodeport" ] && [ -z "$METALLB_POOL_EFF" ]; then
  cs_fail E_VIP_POOL_MISSING "expose=$EXPOSE_MODE" recover="rerun:reserve-vips" \
    hint="Step 1b (reserve-vips) claims the metallb pool from the host's IPAM and has not run for this run id; a preflight re-run also resets it"
fi

INJECT=""
case " ${CS_VALUES_KEYS} " in
  *" SERVICE_EXPOSE_MODE "*) ;;
  *) INJECT="SERVICE_EXPOSE_MODE='$EXPOSE_MODE'" ;;
esac
# A pool is only worth injecting if there is one to inject: the check above has
# already guaranteed a metallb run has one, so this only skips the nodeport case,
# where an empty METALLB_POOL would be set to nothing and reported through the
# rewriter's generic key-list path.
if [ "$EXPOSE_MODE" != "nodeport" ] && [ -n "$METALLB_POOL_EFF" ]; then
  case " ${CS_VALUES_KEYS} " in
    *" METALLB_POOL "*) ;;
    *) INJECT="$INJECT METALLB_POOL='$METALLB_POOL_EFF'" ;;
  esac
fi

# --- upstream DNS -----------------------------------------------------------
# Same precedence shape, and for the same reason: cluster.conf ships
# UPSTREAM_DNS_SERVERS=127.0.0.1, which kubespray hands to nodelocaldns as the
# forwarder for every name outside the cluster. Nothing listens on a node's
# loopback :53, so pods fail every public lookup while the nodes — which use
# their own resolvers — stay perfectly healthy. `env-probe` reads the VMs' real
# resolvers while they are still stock and records them in run.env; that is the
# value that lands here.
#
# Left EMPTY (not defaulted) when neither source has one: the installer's `:-`
# expansion then keeps 127.0.0.1, so an undetectable resolver reproduces the
# documented default rather than writing an empty list, which would render as
# `forward . /etc/resolv.conf` and send coredns into the resolve.conf →
# systemd-resolved → nodelocaldns loop its `loop` plugin FATALs on.
UPSTREAM_DNS_EFF=""
case " ${CS_VALUES_KEYS} " in
  *" UPSTREAM_DNS_SERVERS "*) UPSTREAM_DNS_EFF="$(sed -n "s/^UPSTREAM_DNS_SERVERS='\([^']*\)'\$/\1/p" "$VALUES" | head -1)" ;;
esac
UPSTREAM_DNS_SRC="values"
if [ -z "$UPSTREAM_DNS_EFF" ]; then
  UPSTREAM_DNS_EFF="$(cs_run_env_get UPSTREAM_DNS_SERVERS)"
  UPSTREAM_DNS_SRC="detected"
fi
if [ -n "$UPSTREAM_DNS_EFF" ]; then
  case " ${CS_VALUES_KEYS} " in
    *" UPSTREAM_DNS_SERVERS "*) ;;
    *) INJECT="$INJECT UPSTREAM_DNS_SERVERS='$UPSTREAM_DNS_EFF'" ;;
  esac
else
  UPSTREAM_DNS_SRC="default"
fi

# --- operator image source --------------------------------------------------
# Where the operator's images come from is decided ONCE, by preflight, and this
# step neither re-decides it nor lets the values file carry it. That is narrower
# than every other resolved value above, and deliberately so: the mode is what
# env-probe gated the NODES on at Step 3, and env-probe reads run.env only (it
# takes no values file — it cannot see one). A values-file override here would
# therefore be a mode the precheck never saw, and the two would be free to
# disagree silently: a node check that passed for a run that deployed offline, or
# worse, none run for one that did not. One resolution, one answer.
#
# Absent means the run never stated a mode — a run dir from before this key
# existed — and that resolves to offline, the installer's own default and exactly
# what such a run would have deployed.
#
# INJECTED either way, including the false case. Writing nothing would defer to
# cluster.defaults.conf's ${ONLINE_DEPLOY_CUBESTACK_OPERATOR:-false}, so a run that
# asked for offline would silently follow a later image that flipped that default
# — the same reasoning that pins REGISTRY_ENABLED explicitly.
OPERATOR_IMAGES="$(cs_run_env_get OPERATOR_IMAGES)"
if [ "$OPERATOR_IMAGES" = online ]; then
  INJECT="$INJECT ONLINE_DEPLOY_CUBESTACK_OPERATOR='true'"
else
  INJECT="$INJECT ONLINE_DEPLOY_CUBESTACK_OPERATOR='false'"
fi

# The credential the online mode cannot run without, and the last gate before a
# deploy that would otherwise look successful. The installer's operator module
# does not fail on a missing credential: it warns and clears the CR's
# imagePullSecrets, so the operator itself ImagePullBackOffs while every verdict
# stays green. preflight refuses this combination at Step 0, so reaching here
# means the file moved or run.env was edited — both worth stopping for.
if [ "$OPERATOR_IMAGES" = online ]; then
  HARBOR_RO="$(cs_run_env_get HARBOR_RO_VALUES_FILE)"
  if [ -z "$HARBOR_RO" ]; then
    cs_fail E_CONF_VALUES_MISSING "images=online" recover=stop-report:user \
      hint="this run takes the operator's images from Harbor but no Harbor robot credential is recorded, and without it the installer clears the pull secret and the operator never starts; re-run preflight with --harbor-ro-values, or with --operator-images offline"
  fi
  # Same two-key lint preflight applies, re-applied here: a file that was fine at
  # Step 0 can be rotated, truncated or moved into the third hour of a run.
  #
  # CS_VALUES_KEYS is saved and restored around it because cs_values_lint
  # PUBLISHES the key list it just validated into that variable. This is a SECOND
  # lint of a DIFFERENT file, so without the restore the rest of this script would
  # go on asking "does the values file carry SERVICE_EXPOSE_MODE / GPU_OPERATOR_ENABLED"
  # about the Harbor credential file, and every `case " $CS_VALUES_KEYS " in` test
  # below would answer no. The dry run is what caught it: its `keys` line named
  # HARBOR_RO_USER/HARBOR_RO_PW for a values file that carries neither.
  _keys_save="$CS_VALUES_KEYS"
  cs_values_lint "$HARBOR_RO" HARBOR_RO_USER HARBOR_RO_PW
  CS_VALUES_KEYS="$_keys_save"
fi

# --- budget -----------------------------------------------------------------
# Deliberately AFTER the validation above, for the same reason pod-up validates
# its subnet first: a rejected input file cannot be fixed by re-invoking, so
# charging an attempt for it only spends a lifetime retry on a deterministic
# outcome. It also means the `fix-values:` recovery this lint prescribes can
# actually be executed, instead of being refused by the budget it just spent.
#
# --dry-run is read-only by definition - it exists to be pointed at a live pod
# without consequences - so it never spends one either.
if [ "$DRY_RUN" != 1 ]; then
  cs_budget_guard
fi

# --- pod --------------------------------------------------------------------
cs_pod_require "$POD_ARG"

# --- dry run ----------------------------------------------------------------
# Stops BEFORE anything mutates the pod: no example-seeding, no cp, no rewrite.
# Deliberately placed after the pod lookup so it still proves the pod and the
# values file are usable, which is what makes it useful against a live pod.
if [ "$DRY_RUN" -eq 1 ]; then
  if cs_pod_exec "$CS_POD" bash -c "test -f $CONF_DIR/$CONF_NAME" >/dev/null 2>&1; then
    CONF_STATE=present
  else
    CONF_STATE=absent
  fi
  cs_note "dry run — nothing will be written"
  cs_note "  pod        $CS_POD"
  cs_note "  config     $CONF_DIR/$CONF_NAME ($CONF_STATE)"
  cs_note "  values     $VALUES"
  cs_note "  keys       ${CS_VALUES_KEYS# }"
  cs_note "  ext env    ${EXT_ENV:-none}${EXT_ENV:+ -> $CONF_DIR/$CEPH_ENV_DEST}"
  cs_note "  dns        ${UPSTREAM_DNS_EFF:-none} [$UPSTREAM_DNS_SRC]"
  if [ "$OPERATOR_IMAGES" = online ]; then
    cs_note "  operator   images from Harbor, pulled by the nodes (robot credential: $(basename "$HARBOR_RO"))"
  else
    cs_note "  operator   images from the offline tar via the in-cluster registry"
  fi
  cs_ok "dry_run=1" "conf=$CONF_NAME" "conf_state=$CONF_STATE" "pod=$CS_POD" \
        "ext_env=$EXT_ENV_FLAG" "dns=$UPSTREAM_DNS_SRC" "images=$OPERATOR_IMAGES"
fi

# Regenerate in place; seed from the example ONLY when absent. Re-copying the
# example over an existing config would silently discard Ceph/MetalLB/NODES.
if ! cs_pod_exec "$CS_POD" bash -c "test -f $CONF_DIR/$CONF_NAME" >/dev/null 2>&1; then
  if ! cs_logged kubectl -n "$CS_NS" exec "$CS_POD" -- \
       bash -c "cp $CONF_DIR/${CONF_NAME}.example $CONF_DIR/$CONF_NAME"; then
    cs_fail E_CONF_FIELD_MISSING "conf=$CONF_NAME" recover=stop-report:user \
      hint="neither $CONF_NAME nor its .example exists in the pod"
  fi
fi

# The rewriter is re-copied UNCONDITIONALLY. A stale copy left by an older run
# must never be able to execute — the pod's /tmp does not survive a recreate.
cs_logged kubectl -n "$CS_NS" cp "$SELF_DIR/lib/cubestack-apply-conf.py" \
  "$CS_NS/$CS_POD:/tmp/cubestack-apply-conf.py" || \
  cs_fail E_POD_EXEC "pod=$CS_POD" recover="rerun:pod-up" hint="could not copy the rewriter into the pod"

# Script-scoped, NOT the bare /tmp/cubestack-values.conf. The skill documents
# Steps 4 and 5 as parallel, and fetch-offline copies its own values file into
# the same pod: on one shared path each script's cleanup `rm -f` deletes the file
# the other is about to `source`, and a half-written copy is sourceable as a
# truncated one — a wrong secret rather than a visible error. pod-down shreds the
# whole family.
POD_VALUES="/tmp/cubestack-values.$CS_SCRIPT.conf"
cs_logged kubectl -n "$CS_NS" cp "$VALUES" \
  "$CS_NS/$CS_POD:$POD_VALUES" || \
  cs_fail E_POD_EXEC "pod=$CS_POD" recover="rerun:pod-up" hint="could not copy the values file into the pod"

# The Harbor robot credential, on the same terms, when the run takes the
# operator's images from Harbor. It is a SECOND secret file and it is copied
# rather than folded into the values file, because the values file is the user's
# and this one is the run's: appending a token to it would put the robot password
# in the copy `fetch-offline` sources as well, for no gain. Script-scoped for the
# same reason as POD_VALUES, and pod-down shreds it too — its glob cannot reach
# this name, so the path is listed there explicitly.
POD_HARBOR=""
if [ "$OPERATOR_IMAGES" = online ]; then
  POD_HARBOR="/tmp/cubestack-harbor.$CS_SCRIPT.conf"
  chmod 600 "$HARBOR_RO" 2>/dev/null || true
  cs_logged kubectl -n "$CS_NS" cp "$HARBOR_RO" \
    "$CS_NS/$CS_POD:$POD_HARBOR" || \
  cs_fail E_POD_EXEC "pod=$CS_POD" recover="rerun:pod-up" hint="could not copy the Harbor robot credential into the pod"
fi

# Shred the pod-side credential files on ANY exit path, including failure. This
# is a cs_cleanup hook rather than a `trap ... EXIT` because installing a second
# EXIT trap would replace the verdict trap that cs_init installed.
cs_cleanup() {
  [ -n "${CS_POD:-}" ] || return 0
  # ${POD_HARBOR:+"$POD_HARBOR"} rather than "$POD_HARBOR": an offline run has no
  # second file, and a quoted empty string would ask rm to delete a file literally
  # named "" — which fails, and a failing cleanup on the success path is worse
  # than no cleanup.
  kubectl -n "$CS_NS" exec "$CS_POD" -- rm -f "$POD_VALUES" \
    ${POD_HARBOR:+"$POD_HARBOR"} >/dev/null 2>&1 || true
}

# --- external Ceph env file (official import path) --------------------------
# Placed BEFORE the rewrite so a bad copy costs nothing, and deliberately NOT
# registered with cs_cleanup: the installer sources this file ~12 minutes later,
# mid-deploy, so removing it on exit would break the very deploy it was staged
# for. pod-down removes it once the cluster is verified.
#
# The hash gate is the point of this block. The lint already rejects an
# unbalanced-quote file, which is how truncation usually shows up - but a
# truncation landing on a balanced boundary would pass the lint, and this file
# is what decides whether the consumer can reach the Provider's mons at all. A
# digest comparison is the only check that cannot be fooled by that.
if [ -n "$EXT_ENV" ]; then
  chmod 600 "$EXT_ENV" 2>/dev/null || true
  EXT_SHA="$(cs_sha256 "$EXT_ENV")"
  [ -n "$EXT_SHA" ] || cs_fail E_INTERNAL "file=$EXT_ENV" recover=stop-report:user \
    hint="cannot hash the env file on this host (needs shasum or sha256sum); refusing to deploy against an unverified copy"

  EXT_ENV_POD="$CONF_DIR/$CEPH_ENV_DEST"
  cs_logged kubectl -n "$CS_NS" cp "$EXT_ENV" "$CS_NS/$CS_POD:$EXT_ENV_POD" || \
    cs_fail E_POD_EXEC "pod=$CS_POD" recover="rerun:pod-up" \
    hint="could not copy the external-ceph.env into the pod"

  POD_SHA="$(cs_pod_exec_out "$CS_POD" bash -c "sha256sum $EXT_ENV_POD 2>/dev/null | cut -d' ' -f1" | tail -1)"
  [ "$POD_SHA" = "$EXT_SHA" ] || cs_fail E_POD_EXEC "pod=$CS_POD" \
    recover="rerun:pod-up" \
    hint="the external-ceph.env in the pod does not hash to the local file; refusing to deploy against a truncated copy"

  # Recorded so deploy can re-assert it is still there 12 minutes later, and
  # pod-down can find it to shred.
  cs_run_env_set "EXTERNAL_CEPH_ENV=$(cs_q 1)" "EXTERNAL_CEPH_ENV_DEST=$(cs_q "$CEPH_ENV_DEST")"
fi


# --- rewrite ----------------------------------------------------------------
# Both secret files are sourced with `set -a`, so the rewriter reads the run's
# credentials from the ENVIRONMENT — SSH_PW as SSH_DEFAULT_PASSWORD, and the
# Harbor robot pair as the installer's CUBESTACK_OPERATOR_HARBOR_USER/PASSWORD.
# Nothing secret is ever a shell literal here: an INJECT'd key is part of the
# command line, which is exactly the surface the values file exists to avoid.
SOURCE_CMD="set -a; . $POD_VALUES; set +a"
if [ -n "$POD_HARBOR" ]; then
  SOURCE_CMD="set -a; . $POD_VALUES; . $POD_HARBOR; set +a"
fi
out="$(cs_pod_exec "$CS_POD" bash -c "
  $SOURCE_CMD
  $INJECT CS_EXT_CEPH_ENV=$EXT_ENV_FLAG python3 /tmp/cubestack-apply-conf.py $CONF_DIR/$CONF_NAME $POD_VALUES")"
rc=$?

case "$rc" in
  0) ;;
  10|1) cs_fail E_CONF_FIELD_MISSING "conf=$CONF_NAME" recover=stop-report:user \
          hint="$(printf '%s' "$out" | grep -m1 '^FAIL:' | cut -c1-120)" ;;
  11|12|13) # The key list embedded in recover= is sanitized to [A-Z_,] before it
          # goes in. The raw rewriter output carries newlines and prose, and a
          # verb containing whitespace is unparseable — the contract's whole
          # guarantee is that a recover= value is a single whitespace-free token.
          keys="$(printf '%s' "$out" | grep -m1 '^FAIL:' | sed 's/.*missing: //' \
                  | tr -c 'A-Z_,' '\n' | tr -d '\n' | cut -c1-80)"
          case "$keys" in ''|*[!A-Z_,]*) keys=all ;; esac
          cs_fail E_CONF_VALUES_MISSING "conf=$CONF_NAME" \
          recover="fix-values:$VALUES:$keys" \
          hint="$(printf '%s' "$out" | grep -m1 '^FAIL:' | cut -c1-120)" ;;
  14) # Its own branch rather than folding into the key-list case above: this
      # failure has no "missing:" list to extract, and the two keys the user has
      # to reconcile are known exactly. Folding it in would run the message
      # through the uppercase-only sanitizer and hand back a garbled verb.
      cs_fail E_CONF_VALUES_MISSING "conf=$CONF_NAME" \
        recover="fix-values:$VALUES:REGISTRY_ENABLED,LOCAL_PATH_ENABLED" \
        hint="$(printf '%s' "$out" | grep -m1 '^FAIL:' | cut -c1-120)" ;;
  15) # A malformed resolver. Its own branch for branch-14's reason (no "missing:"
      # list), and one more: the key to fix is a single known key, and when it
      # came from DETECTION rather than the values file the fix is to write the
      # key, not to edit an existing one — so naming it is the whole message.
      cs_fail E_CONF_VALUES_MISSING "conf=$CONF_NAME" \
        recover="fix-values:$VALUES:UPSTREAM_DNS_SERVERS" \
        hint="$(printf '%s' "$out" | grep -m1 '^FAIL:' | cut -c1-120)" ;;
  *) cs_fail E_INTERNAL "rc=$rc" recover=stop-report:user \
          hint="rewriter failed: $(printf '%s' "$out" | grep -m1 '^FAIL:' | cut -c1-100)" ;;
esac
applied="$(printf '%s' "$out" | grep -m1 '^applied:' | sed 's/^applied: //')"

# --- byte-gate --------------------------------------------------------------
# The automated approval gate that replaces a human diff review: a diff can
# look right while the bytes on disk hold `***`.
#
# The remote side prints an explicit verdict and always exits 0, because both
# obvious shorthands lie here:
#
#   * folding kubectl's stderr in (cs_pod_exec) turns the CLEAN case into
#     apparent evidence — `grep -q` misses, exits 1, kubectl reports
#     `command terminated with exit code 1`, and the caller sees a non-empty
#     string. That made this gate fail on every run, clean or not.
#   * testing the exit status instead cannot tell a clean config from a
#     transport failure (both surface as "no output"), so an unreachable pod
#     would silently PASS the one check that exists to catch a leaked secret.
#
# So anything that is not an explicit GATE_CLEAN is a failure.
gate="$(cs_pod_exec_out "$CS_POD" bash -c "
  if [ ! -f $CONF_DIR/$CONF_NAME ]; then echo GATE_NOFILE; exit 0; fi
  if grep -E '^(SSH_DEFAULT_PASSWORD|MINIO_ENDPOINT|MINIO_ACCESS_KEY|MINIO_SECRET_KEY|CEPH_KEYRING|CEPHFS_KEYRING)=' $CONF_DIR/$CONF_NAME | grep -qF '***'; then
    echo GATE_LEAK
  else
    echo GATE_CLEAN
  fi" | tail -1)"
case "$gate" in
  GATE_CLEAN) ;;
  GATE_LEAK) cs_fail E_CONF_REDACTED "where=conf" "conf=$CONF_NAME" \
               recover="fix-values:$VALUES:all" \
               hint="redaction artifacts are on disk in $CONF_NAME; do not proceed to deploy" ;;
  GATE_NOFILE) cs_fail E_CONF_FIELD_MISSING "conf=$CONF_NAME" recover=stop-report:user \
               hint="$CONF_NAME vanished from the pod between the rewrite and the gate" ;;
  *) cs_fail E_POD_EXEC "pod=$CS_POD" \
       "gate=$(printf '%s' "${gate:-empty}" | tr -c 'A-Za-z0-9._:@/+,-' '_' | cut -c1-40)" \
       recover="rerun:pod-up" \
       hint="could not read the byte-gate result back from the pod; refusing to assume the config is clean" ;;
esac

# Record whether external CephFS was requested, for verify to gate on.
#
# CEPHFS_FS IS the external-CephFS switch in the installer
# (EXT_CEPHFS_ENABLED="${CEPHFS_FS:-}"), so an RBD-only external import never
# runs the CephFS module and therefore never creates a CephFS StorageClass.
# Without this record `verify --ceph` would demand one anyway and fail a
# perfectly healthy RBD-only cluster - a false failure that then sends the
# model to rerun:deploy, which reproduces it. Absent (older run dir): verify
# keeps requiring it, so this can only ever remove a false failure, never
# introduce a false pass.
CEPHFS_REQ=0
case " ${CS_VALUES_KEYS} " in
  *" CEPHFS_FS "*) CEPHFS_REQ=1 ;;
esac

# On the OFFICIAL path there is no CEPHFS_FS in the values file at all - the FS
# name travels inside the Provider's env file, and the module creates the CephFS
# StorageClasses when CEPHFS_FS_NAME *and* CEPHFS_POOL_NAME are both non-empty
# (03_ceph_csi.sh:311). Reading only the values file would therefore report
# "RBD only" for a cluster that does have CephFS, and `verify --ceph` would skip
# the very check that exists to catch a missing file system.
#
# Name only ever tested for emptiness, never printed.
if [ "$EXT_ENV_FLAG" = 1 ]; then
  CEPHFS_ENV_NAME="$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?CEPHFS_FS_NAME=(.*)$/\2/p' "$EXT_ENV" \
    | head -1 | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'\$//")"
  [ -n "$CEPHFS_ENV_NAME" ] && CEPHFS_REQ=1
fi
cs_run_env_set "CEPHFS_REQUESTED=$(cs_q $CEPHFS_REQ)"

# Record whether the in-cluster registry was asked for, for verify to gate on.
#
# The registry is a BASE module, so `verify` reads an absent registry Service as
# proof the deploy did not finish. That reasoning holds only while the registry
# is always on; REGISTRY_ENABLED=false (a supported key as of this change) turns
# it off on purpose, and without this record verify would fail a cluster built
# exactly as asked - the same false-negative shape the Envoy data-plane check had.
#
# Absent defaults to ON, i.e. today's behaviour, so an older run dir keeps
# requiring the Service. Like CEPHFS_REQUESTED this can only ever remove a false
# failure, never introduce a false pass.
REGISTRY_REQ=1
case " ${CS_VALUES_KEYS} " in
  *" REGISTRY_ENABLED "*)
    REGISTRY_VALUE="$(sed -n "s/^REGISTRY_ENABLED='\([^']*\)'\$/\1/p" "$VALUES" | head -1)"
    case "$REGISTRY_VALUE" in
      true|TRUE|True|1|yes|YES|Yes|on|ON|On) REGISTRY_REQ=1 ;;
      *) REGISTRY_REQ=0 ;;
    esac
    ;;
esac
cs_run_env_set "REGISTRY_REQUESTED=$(cs_q $REGISTRY_REQ)"

# Record the effective expose mode for verify to gate on. MetalLB is a required
# component by default, but it is installed only in metallb mode — so `verify`
# cannot infer the intent from the cluster: a deliberate nodeport run and a
# metallb install that silently did nothing both present as "no metallb-system".
# Only the run's own record tells them apart. Absent (a run dir older than this
# key) means ON, matching the default.
METALLB_REQ=1
case "$EXPOSE_MODE" in nodeport|nodePort) METALLB_REQ=0 ;; esac
cs_run_env_set "METALLB_REQUESTED=$(cs_q $METALLB_REQ)"

# Record the two device addons for verify to gate on, by the same rule as the
# three above.
#
# These matter more than they look. Both addons can complete, print their ✅, and
# deliver nothing a workload can use - the GPU operator via its CPU fast path
# (which leaves metax-driver in CrashLoopBackOff) and the RDMA plugin via its
# placeholder mode - and in both cases the deployed cluster looks healthy. verify
# cannot infer the intent from the cluster, so the run's own record is the only
# thing that tells "this box was built without GPUs" apart from "the driver
# never came up".
#
# Absent defaults to ON, which is the installer's own default for both keys
# (`${GPU_OPERATOR_ENABLED:-true}`, `${RDMA_ENABLED:-true}` in
# cluster.conf.example) - so this can only ever remove a false failure, never
# introduce a false pass, and an older run dir keeps today's behaviour.
device_req() {  # $1 = values key -> 1 when enabled (absent or true), else 0
  case " ${CS_VALUES_KEYS} " in
    *" $1 "*) ;;
    *) echo 1; return ;;
  esac
  case "$(sed -n "s/^$1='\([^']*\)'\$/\1/p" "$VALUES" | head -1)" in
    true|TRUE|True|1|yes|YES|Yes|on|ON|On) echo 1 ;;
    *) echo 0 ;;
  esac
}
GPU_REQ="$(device_req GPU_OPERATOR_ENABLED)"
RDMA_REQ="$(device_req RDMA_ENABLED)"
cs_run_env_set "GPU_OPERATOR_REQUESTED=$(cs_q "$GPU_REQ")"
cs_run_env_set "RDMA_REQUESTED=$(cs_q "$RDMA_REQ")"

# env-ok is deliberately KEPT here. It attests that password SSH worked for
# this VM set, and configure does not change that: it writes the SSH_PW the
# run's values file already carried at Step 3. Clearing it (as this used to)
# made the FIRST deploy of every fresh run fail E_DEPLOY_PRECOND_ENV — nothing
# re-wrote the stamp until the operator re-ran env-probe by hand. The only way
# to invalidate it is editing SSH_PW *after* Step 3, and that is a Step 3
# mistake: env-probe must be run with the password the values file carries.
cs_stamp_write conf-ok "$CONF_NAME"

cs_note "applied: $applied"
cs_note "byte-gate: clean (no *** artifacts)"
if [ "$OPERATOR_IMAGES" = online ]; then
  cs_note "operator images: online — the nodes pull the operator's images from Harbor," \
          "so the robot credential is in cluster.conf as CUBESTACK_OPERATOR_HARBOR_USER/PASSWORD" \
          "(Step 3 proved each node can reach Harbor)"
else
  cs_note "operator images: offline — from the offline tar via the in-cluster registry"
fi
[ "$EXT_ENV_FLAG" = 1 ] && cs_note "external Ceph: official import path ($CEPH_ENV_DEST hash-verified, left in place for the deploy)"
if [ "$UPSTREAM_DNS_SRC" = default ]; then
  # Scoped to "first configure" on purpose: an injection is what puts a value IN
  # cluster.conf, so with nothing to inject the file is left exactly as it was —
  # the shipped 127.0.0.1 on a fresh run, a previous run's resolvers otherwise.
  # Claiming the sentinel outright would be a false alarm on the re-configure
  # path, which reaches here whenever env-probe ran again after the deploy (the
  # VMs then resolve through nodelocaldns itself, which the detection filters).
  cs_note "upstream DNS: nothing from the values file or env-probe; cluster.conf is left unchanged — on a first configure that is the shipped 127.0.0.1, which fails every public lookup made from a pod"
else
  cs_note "upstream DNS: $UPSTREAM_DNS_EFF [$UPSTREAM_DNS_SRC]"
fi
cs_ok "conf=$CONF_NAME" "pod=$CS_POD" "applied=$(printf '%s' "$applied" | tr ' ' ',')" \
      "ext_env=$EXT_ENV_FLAG" "cephfs=$CEPHFS_REQ" "registry=$REGISTRY_REQ" \
      "metallb=$METALLB_REQ" "gpu=$GPU_REQ" "rdma=$RDMA_REQ" "dns=$UPSTREAM_DNS_SRC" \
      "images=$OPERATOR_IMAGES"
