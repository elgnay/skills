#!/usr/bin/env bash
# env-probe — every Step 3 pre-deploy reachability check, in one call.
#
# READ-ONLY against the cluster (it does install sshpass inside the pod). This
# replaces ~5+N hand-written `kubectl exec` probes with one invocation and one
# verdict line, so the model never reads raw probe output and never mis-reads a
# "SSH FAIL" string as something else.
#
# Four risk classes live in this one step and they have four DIFFERENT recovery
# verbs, but a verdict carries one code. So the classes are checked in a FIXED
# precedence and the first class that fails is the one reported:
#
#   1. pod exec works at all ................ E_POD_EXEC       rerun:pod-up
#   2. sshpass present (install if missing) .. E_SSHPASS_INSTALL rerun:env-probe
#   3. VM TCP port 22 ....................... E_SSH_TCP        sibling-vm:rebuild:<names>
#   4. password SSH as the given user ....... E_SSH_AUTH       sibling-vm:rebuild:<names>
#   4b. upstream DNS (DETECTED, never a check) — see below
#   5. MinIO TCP ............................ E_MINIO_UNREACHABLE stop-report:admin
#   6. Harbor DNS then port 443 ............. E_HARBOR_DNS / E_HARBOR_UNREACHABLE
#                                                            stop-report:admin
#
# Class 4b is the one entry here that is not a check. `cluster.conf` ships
# UPSTREAM_DNS_SERVERS=127.0.0.1, which kubespray writes into nodelocaldns as the
# forwarder for everything outside the cluster — a loopback port with nothing on
# it. The nodes keep resolving (they use their own resolvers via
# systemd-resolved) while every POD silently fails every public lookup, so the
# failure is invisible until something downstream needs a public name. The value
# has to be the resolvers the VMs themselves use, and the only reliable moment to
# read them is NOW: once the install lands, the VM's own resolver IS the thing
# being configured (nodelocaldns at 169.254.25.10), so the address is gone. So it
# is detected here, recorded in run.env, and injected by `configure`. It is
# recorded even when detection finds nothing (as an empty value), because run.env
# deliberately survives a re-provisioned box and a stale address from a previous
# VM set is worse than no address at all. See the block itself for why an address
# is only adopted once a VM has resolved a public name with it.
#
# Within a class the probes BATCH: two of three VMs failing SSH is one verdict
# naming both (`vms=a,b`), because the recovery acts on the set. Fail fast on
# the first failing CLASS, never on the first failing VM.
#
# The SSH password is used but never printed and never stored — the env-ok stamp
# digests the VM set, the user, and the password's PRESENCE only.
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/verdict.sh
. "$SELF_DIR/lib/verdict.sh"
# shellcheck source=lib/common.sh
. "$SELF_DIR/lib/common.sh"
cs_init

usage() {
  cat <<'USAGE'
env-probe --vms a@IP,b@IP [options]

  --vms LIST        name@ip pairs, comma-separated (required)
  --run ID          the run this probe belongs to (default: this run's id)
  --pod NAME        installer pod (default: this run's, <prefix>-<run-id>)
  --user USER       SSH user (default ubuntu)
  --password PW     SSH password (default: $CUBESTACK_SSH_PASSWORD, else ubuntu)
  --minio-ip IP     MinIO host to probe (default: from run.env MINIO_EP)
  --minio-port P    MinIO port (default 9000)
  --harbor FQDN     Harbor endpoint (default $CS_HARBOR_DEFAULT)
  --harbor-port P   Harbor port (default 443)
  -h, --help        this text

Checks, in this order: pod exec, sshpass, VM port 22, password SSH, MinIO,
Harbor. On success writes the env-ok stamp; the verdict reports how many probes
ran so "0 of 3" can never look like OK.

It also DETECTS, rather than checks, the VMs' own upstream resolvers and records
them as UPSTREAM_DNS_SERVERS in run.env for `configure` to inject into
cluster.conf (the shipped 127.0.0.1 makes nodelocaldns forward public names at a
dead loopback port, which breaks DNS for every pod while the nodes stay fine).
An address is adopted only if a VM resolved a public name with it; anything found
but unconfirmed is reported, not used. The verdict carries dns=<csv> or
dns=none, and a values file that sets the key overrides all of it.
USAGE
}

VMS=""
POD_ARG=""
SSH_USER="ubuntu"
SSH_PW="${CUBESTACK_SSH_PASSWORD:-ubuntu}"
MINIO_IP=""
MINIO_PORT="9000"
HARBOR="$CS_HARBOR_DEFAULT"
HARBOR_PORT="443"

while [ $# -gt 0 ]; do
  case "$1" in
    --vms) cs_need_val "$@";         VMS="${2:-}"; shift 2 ;;
    --run) cs_need_val "$@";         cs_run_opt "${2:-}"; shift 2 ;;
    --pod) cs_need_val "$@";         POD_ARG="${2:-}"; shift 2 ;;
    --user) cs_need_val "$@";        SSH_USER="${2:-}"; shift 2 ;;
    --password) cs_need_val "$@";    SSH_PW="${2:-}"; shift 2 ;;
    --minio-ip) cs_need_val "$@";    MINIO_IP="${2:-}"; shift 2 ;;
    --minio-port) cs_need_val "$@";  MINIO_PORT="${2:-}"; shift 2 ;;
    --harbor) cs_need_val "$@";      HARBOR="${2:-}"; shift 2 ;;
    --harbor-port) cs_need_val "$@"; HARBOR_PORT="${2:-}"; shift 2 ;;
    -h|--help)     usage; cs_ok "help=1" ;;
    *)             cs_usage_fail "unknown argument: $1" ;;
  esac
done

[ -n "$VMS" ] || cs_usage_fail "--vms a@IP,b@IP is required"

# A password the tool layer redacted to *** is not a wrong password — rebuilding
# the VM for it would be the wrong recovery. Refuse it here, before any probe.
if ! cs_check_redaction SSH_PW; then
  cs_usage_fail "the SSH password carries the redaction artifact (${CS_BAD_KEYS}); pass the real value - it will not be printed"
fi
[ -n "$SSH_PW" ] || cs_usage_fail "--password must not be empty"

if [ -z "$MINIO_IP" ]; then
  # run.env holds the RESOLVED MinIO endpoint (non-secret); strip scheme/port.
  MINIO_EP="$(cs_run_env_get MINIO_EP)"
  MINIO_IP="$(printf '%s' "$MINIO_EP" | sed -e 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||' -e 's|/.*$||' -e 's|:.*$||')"
fi
[ -n "$MINIO_IP" ] || cs_usage_fail "--minio-ip is required (not set on the command line or in run.env)"

# The kubeconfig guard sits ABOVE the budget for reserve-vips' reason: spending
# an attempt on a host that cannot answer would make the budget meaningless.
cs_kubeconfig_guard
cs_budget_guard

# --- 1. pod exec ------------------------------------------------------------
# cs_pod_require sets CS_POD and fails through the verdict (never inside $( )).
cs_pod_require "$POD_ARG"
EXEC_OUT="$(cs_pod_exec "$CS_POD" bash -c 'echo CS_EXEC_OK')"
case "$EXEC_OUT" in
  *CS_EXEC_OK*) ;;
  *) cs_fail E_POD_EXEC "pod=$CS_POD" recover="rerun:pod-up" \
       hint="kubectl exec into pod $CS_POD produced no output; the pod is not usable as a bootstrap host" ;;
esac
CHECKED=1

# --- 2. sshpass -------------------------------------------------------------
# kubespray needs it for the initial password SSH into the VMs.
SSHPASS_STATE="present"
if ! cs_pod_exec "$CS_POD" bash -c 'command -v sshpass' >/dev/null 2>&1; then
  installed=0
  attempt=1
  while [ "$attempt" -le 2 ]; do
    # Noisy (apt output) — to the log file, never to stdout.
    if cs_logged cs_pod_exec "$CS_POD" bash -c 'apt-get install -y -qq sshpass'; then
      installed=1
      break
    fi
    attempt=$((attempt + 1))
    [ "$attempt" -le 2 ] && sleep 10
  done
  if [ "$installed" -ne 1 ]; then
    cs_fail E_SSHPASS_INSTALL "pod=$CS_POD" recover="rerun:env-probe" \
      hint="sshpass is missing and apt-get install failed twice; kubespray cannot do password SSH without it"
  fi
  SSHPASS_STATE="installed"
fi
CHECKED=$((CHECKED + 1))

# --- target list ------------------------------------------------------------
# name@ip pairs, split into two parallel comma-lists.
VM_NAMES=""
VM_IPS=""
OLDIFS="$IFS"
IFS=,
set -f
for entry in $VMS; do
  [ -n "$entry" ] || continue
  vname="${entry%@*}"
  vip="${entry#*@}"
  if [ -z "$vname" ] || [ -z "$vip" ] || [ "$vname" = "$vip" ]; then
    set +f; IFS="$OLDIFS"
    cs_usage_fail "--vms entry '$entry' is not name@ip"
  fi
  VM_NAMES="$VM_NAMES${VM_NAMES:+,}$vname"
  VM_IPS="$VM_IPS${VM_IPS:+,}$vip"
done
set +f
IFS="$OLDIFS"
[ -n "$VM_NAMES" ] || cs_usage_fail "--vms carried no usable name@ip pair"
VM_COUNT=0
IFS=,; set -f
for v in $VM_NAMES; do VM_COUNT=$((VM_COUNT + 1)); done
set +f; IFS="$OLDIFS"

# Background probes only ever WRITE A RESULT FILE. cs_fail must not run in a
# subshell (it would exit only that subshell and the caller would carry on), so
# every failure is evaluated here, in the main shell, after `wait`.
TMPD="$(mktemp -d 2>/dev/null || printf '/tmp/cs-env-probe.%s' "$$")"
mkdir -p "$TMPD" 2>/dev/null || true
# Scratch cleanup goes through the cs_cleanup hook, which cs_on_exit runs BEFORE
# it decides the verdict. Do not chain a second EXIT trap instead:
# `trap 'rm -rf "$TMPD"; cs_on_exit' EXIT` looks like it preserves the verdict
# trap, but the `rm` clobbers `$?` before cs_on_exit reads it — cs_on_exit then
# sees rc=0, so a SIGTERM is reported as E_INTERNAL rc=0 rather than
# E_INTERRUPTED signal=TERM. (Measured; the verdict still lands, but the
# diagnosis is wrong and rc=0 reads as a clean exit.)
cs_cleanup() { rm -rf "$TMPD" 2>/dev/null || true; }

# 3 attempts over ~30 s per target.
tcp22_probe() {  # $1 = name, $2 = ip, $3 = result file
  n=0
  while [ "$n" -lt 3 ]; do
    if cs_pod_exec "$CS_POD" bash -c \
        "timeout 3 bash -c 'echo > /dev/tcp/$2/22'" >/dev/null 2>&1; then
      printf 'ok %s\n' "$1" > "$3"
      return 0
    fi
    n=$((n + 1))
    [ "$n" -lt 3 ] && sleep 10
  done
  printf 'fail %s\n' "$1" > "$3"
}

# --- 3. VM TCP 22 -----------------------------------------------------------
idx=0
IFS=,; set -f
for vname in $VM_NAMES; do
  idx=$((idx + 1))
  vip="$(printf '%s' "$VM_IPS" | cut -d, -f"$idx")"
  ( tcp22_probe "$vname" "$vip" "$TMPD/tcp.$idx" ) &
done
set +f; IFS="$OLDIFS"
wait
# Collect by INDEX, never by glob. Two reasons: `set -f` above is still in
# effect here (a glob would silently stay literal and every failure would read
# as a pass), and a probe that never reported must count as a failure — "0 of 3
# ran" can never masquerade as OK.
BAD_TCP=""
idx=0
IFS=,; set -f
for vname in $VM_NAMES; do
  idx=$((idx + 1))
  f="$TMPD/tcp.$idx"
  if [ ! -f "$f" ] || [ "$(awk 'NR==1{print $1}' "$f" 2>/dev/null)" != "ok" ]; then
    BAD_TCP="$BAD_TCP${BAD_TCP:+,}$vname"
  fi
done
set +f; IFS="$OLDIFS"
if [ -n "$BAD_TCP" ]; then
  cs_fail E_SSH_TCP "vms=$BAD_TCP" "port=22" recover="sibling-vm:rebuild:$BAD_TCP" \
    hint="port 22 is not reachable from the pod on these VMs after 3 attempts over ~30s"
fi
CHECKED=$((CHECKED + VM_COUNT))

# --- 4. password SSH --------------------------------------------------------
# This is the check that delegated VM creation produced working password auth
# (catches a redacted cloud-init passwd or a publickey-only VM).
idx=0
IFS=,; set -f
for vname in $VM_NAMES; do
  idx=$((idx + 1))
  vip="$(printf '%s' "$VM_IPS" | cut -d, -f"$idx")"
  ( out="$(cs_probe_ssh "$vip" "$SSH_USER" "$SSH_PW" 3)"
    # cs_probe_ssh merges the remote stderr (the known-hosts Warning) into its
    # output; keep only the hostname line, and treat any error-ish remnant as a
    # failure rather than "something printed, so it must have worked".
    host="$(printf '%s\n' "$out" | grep -vE '^(Warning:|$)' | tail -1)"
    case "$host" in
      ''|*rror*|*enied*|*'command terminated'*|*'unable to'*|*'timed out'*)
        printf 'fail %s\n' "$vname" > "$TMPD/ssh.$idx" ;;
      *)
        printf 'ok %s %s\n' "$vname" "$host" > "$TMPD/ssh.$idx" ;;
    esac ) &
done
set +f; IFS="$OLDIFS"
wait
BAD_SSH=""
idx=0
IFS=,; set -f
for vname in $VM_NAMES; do
  idx=$((idx + 1))
  f="$TMPD/ssh.$idx"
  if [ ! -f "$f" ] || [ "$(awk 'NR==1{print $1}' "$f" 2>/dev/null)" != "ok" ]; then
    BAD_SSH="$BAD_SSH${BAD_SSH:+,}$vname"
  fi
done
set +f; IFS="$OLDIFS"
if [ -n "$BAD_SSH" ]; then
  cs_fail E_SSH_AUTH "vms=$BAD_SSH" "user=$SSH_USER" recover="sibling-vm:rebuild:$BAD_SSH" \
    hint="password SSH as $SSH_USER failed after 3 attempts; the VM did not get password auth - rebuild just these VMs"
fi
CHECKED=$((CHECKED + VM_COUNT))

# --- 4b. upstream DNS (detection, not a check) ------------------------------
# Read the resolvers the VMs themselves use, while they are still stock. Two
# sources, because either can be the real one: `resolvectl dns` when
# systemd-resolved is running, and /etc/resolv.conf for the images where
# cloud-init wrote the nameservers straight into it.
#
# The remote command is wrapped in SINGLE quotes on purpose: it goes into a
# double-quoted `bash -c` locally and then into another `bash -c` inside the
# pod, so without them the `;` would split at the POD and only the first command
# would ever reach the VM. Single quotes survive both levels literally and ssh
# hands the whole string to the remote shell as one command. That is also why
# the string below contains no `$`, backtick or backslash — the local shell
# would expand those before they were ever sent.
#
# The same round trip also asks the VM to actually RESOLVE a public name with
# whatever it just reported. That is not decoration: a real-but-unreachable
# upstream is WORSE than the shipped sentinel. `forward . 127.0.0.1` is refused
# instantly, so a pod's public lookup fails fast; a dead external address is
# black-holed, so the same lookup hangs for the forward timeout instead — and
# that is what an offline site would get if this were adopted on sight. So the
# detection is only TRUSTED for a VM that demonstrably resolved. (www.baidu.com
# is the probe because this platform is deployed in China and it is resolvable
# from the public resolvers the VMs are given; it only gates the automatic
# value, never a value supplied in the values file.)
DNS_CMD="'resolvectl dns 2>/dev/null; cat /etc/resolv.conf 2>/dev/null; timeout 4 getent hosts www.baidu.com >/dev/null 2>&1 && echo CS_DNS_RESOLVES; echo CS_DNS_DONE'"
idx=0
IFS=,; set -f
for vname in $VM_NAMES; do
  idx=$((idx + 1))
  vip="$(printf '%s' "$VM_IPS" | cut -d, -f"$idx")"
  ( out="$(cs_probe_ssh "$vip" "$SSH_USER" "$SSH_PW" 3 "$DNS_CMD")"
    # `out` carries ssh's own stderr, and the known-hosts Warning names the VM's
    # address — which the generic IPv4 scan below would happily read back as an
    # "upstream resolver". Drop the warning lines and the VM's own address: a VM
    # is never its own resolver.
    printf '%s\n' "$out" \
      | grep -vE '^(Warning:|$)' \
      | grep -Eo '[0-9]{1,3}(\.[0-9]{1,3}){3}' \
      | awk -F. 'NF==4 && $1<=255 && $2<=255 && $3<=255 && $4<=255 {print}' \
      | grep -Ev '^(127\.|169\.254\.|0\.|255\.)' \
      | grep -Fvx "$vip" \
      | sort -u > "$TMPD/dns.$idx"
    case "$out" in
      *CS_DNS_RESOLVES*) printf 'yes\n' > "$TMPD/dnsq.$idx" ;;
      *)                 printf 'no\n'  > "$TMPD/dnsq.$idx" ;;
    esac ) &
done
set +f; IFS="$OLDIFS"
wait
# Union across the VMs that CONFIRMED, in VM order (first VM's first address
# leads) so a run's recorded value is stable for a given VM set rather than
# sort-dependent. DNS_SEEN keeps everything found, confirmed or not, purely so
# the note line can name addresses the operator may want to set by hand.
#
# SPACE-separated, not comma: that is the installer's own format for this key
# (cluster.conf.example documents "10.66.2.1 223.5.5.5", and
# sync-kubespray-config.sh turns spaces into the YAML list separator). A
# comma-joined value survives that tool by accident, so getting it wrong here
# would look right until something else parsed it.
UPSTREAM_DNS=""
DNS_SEEN=""
idx=0
IFS=,; set -f
for vname in $VM_NAMES; do
  idx=$((idx + 1))
  f="$TMPD/dns.$idx"
  [ -f "$f" ] || continue
  confirmed=no
  [ "$(cat "$TMPD/dnsq.$idx" 2>/dev/null)" = yes ] && confirmed=yes
  while read -r addr; do
    [ -n "$addr" ] || continue
    case " $DNS_SEEN " in
      *" $addr "*) ;;
      *) DNS_SEEN="$DNS_SEEN${DNS_SEEN:+ }$addr" ;;
    esac
    [ "$confirmed" = yes ] || continue
    case " $UPSTREAM_DNS " in
      *" $addr "*) ;;
      *) UPSTREAM_DNS="$UPSTREAM_DNS${UPSTREAM_DNS:+ }$addr" ;;
    esac
  done < "$f"
done
set +f; IFS="$OLDIFS"
# Recorded UNCONDITIONALLY, empty included: run.env survives a re-provisioned
# box by design, so not writing here would leave a previous VM set's resolvers
# in place for a box that never confirmed them.
cs_run_env_put "UPSTREAM_DNS_SERVERS=$(cs_q "$UPSTREAM_DNS")"
if [ -z "$UPSTREAM_DNS" ]; then
  # Not fatal — a values file can still supply it, and the installer's 127.0.0.1
  # default is the status quo rather than a new breakage. But it IS the silent
  # one, so say it out loud on the note line, and name what was found when the
  # reason was "found, but this VM could not resolve with it".
  if [ -n "$DNS_SEEN" ]; then
    cs_note "resolvers $DNS_SEEN were read from the VMs, but no VM resolved a public" \
            "name with them, so none is recorded: a dead upstream HANGS pod lookups" \
            "where the 127.0.0.1 sentinel fails them fast. If they are right anyway," \
            "set UPSTREAM_DNS_SERVERS in the values file."
  else
    cs_note "no upstream resolver found on the VMs, so none is recorded and the" \
            "shipped 127.0.0.1 sentinel will stand unless the values file sets" \
            "UPSTREAM_DNS_SERVERS — with it, every public lookup made from a pod" \
            "fails (cluster-internal names are unaffected)."
  fi
fi
CHECKED=$((CHECKED + VM_COUNT))
# The verdict carries one token per k=v pair, so the space-separated value is
# rendered comma-separated for the LINE only; run.env and cluster.conf keep the
# installer's space-separated form.
DNS_VERDICT=""
[ -n "$UPSTREAM_DNS" ] && DNS_VERDICT="${UPSTREAM_DNS// /,}"

# --- 5. MinIO ---------------------------------------------------------------
if ! cs_probe_tcp "$MINIO_IP" "$MINIO_PORT" 3; then
  cs_fail E_MINIO_UNREACHABLE "minio=$MINIO_IP:$MINIO_PORT" recover=stop-report:admin \
    hint="MinIO is not reachable from the pod; the offline package fetch would fail"
fi
CHECKED=$((CHECKED + 1))

# --- 6. Harbor --------------------------------------------------------------
# Resolve first, so "does not resolve" and "port closed" stay distinguishable.
HARBOR_IP="$(cs_pod_exec "$CS_POD" bash -c \
  "getent hosts $HARBOR 2>/dev/null | awk '{print \$1}' | head -1")"
if [ -z "$HARBOR_IP" ]; then
  HARBOR_IP="$(cs_pod_exec "$CS_POD" bash -c \
    "python3 -c \"import socket;print(socket.gethostbyname('$HARBOR'))\" 2>/dev/null")"
fi
HARBOR_IP="$(printf '%s\n' "$HARBOR_IP" | grep -E '^[0-9]+\.' | head -1)"
if [ -z "$HARBOR_IP" ]; then
  cs_fail E_HARBOR_DNS "harbor=$HARBOR" recover=stop-report:admin \
    hint="Harbor does not resolve from inside the pod; the installer image could not be pulled"
fi
if ! cs_probe_tcp "$HARBOR_IP" "$HARBOR_PORT" 3; then
  cs_fail E_HARBOR_UNREACHABLE "harbor=$HARBOR" "ip=$HARBOR_IP" "port=$HARBOR_PORT" \
    recover=stop-report:admin \
    hint="Harbor resolves ($HARBOR_IP) but port $HARBOR_PORT is closed from the pod"
fi
CHECKED=$((CHECKED + 1))

# --- stamp ------------------------------------------------------------------
# Digest of the VM set + SSH user + password PRESENCE. Never the password, and
# never a hash of it. Falls back to cksum where no sha is available.
digest_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
  elif command -v cksum >/dev/null 2>&1; then
    printf '%s' "$1" | cksum | awk '{print $1}'
  else
    printf 'unhashable'
  fi
}
PW_PRESENCE="absent"
[ -n "$SSH_PW" ] && PW_PRESENCE="present"
VMSET_DIGEST="$(digest_of "$VMS|$SSH_USER|$PW_PRESENCE")"
cs_stamp_write env-ok "vms_digest=$VMSET_DIGEST user=$SSH_USER password=$PW_PRESENCE vms=$VM_COUNT sshpass=$SSHPASS_STATE"

cs_ok "checked=$CHECKED" "sshpass=$SSHPASS_STATE" "vms=$VM_COUNT" "minio=ok" "harbor=ok" \
  "dns=${DNS_VERDICT:-none}"
