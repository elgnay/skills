#!/usr/bin/env bash
# preflight — resolve every Step 0 prerequisite against the live cluster.
#
# READ-ONLY. Re-runnable at any time; the instant the user changes one answer,
# run it again. This replaces the old "resolve, then re-resolve only what
# changed" prose: the resolution rules are deterministic and live here, not in
# the model's judgement.
#
# It never chooses for the user on things the user stated, and never presents a
# menu where a rule exists:
#   subnet -> the one with the most nodes able to host the requested shape
#             (ties break on the lexicographically lowest subnet label)
#   index  -> first free cubestack<N>, across VMs *and* pools
#
# It deliberately resolves NOTHING about the VM's network attachment. A VM gets
# its underlay address from a **cubestack-ipam pool claim**, and choosing that
# pool is VM provisioning — which Step 1 delegates wholesale to the sibling
# `suanova-dev-vm` skill, along with the manifest, the cloud-init hashing and the
# `kubectl apply`. There is no NAD to select either: the controller mints
# `default/<vm-name>-static` from the claim, so it does not exist yet at Step 0.
#
# A predecessor of this file grepped NAD names for the subnet label. That held
# only while a single shared NAD (`vm-underlay-10-66-3-0`) carried the label in
# its name; the cluster deleted it on 2026-09-29 and moved every VM to a pool
# claim, so the grep matched nothing and healthy runs died as
# `E_SUBNET_UNRESOLVED recover=stop-report:admin`. The subnet had resolved fine.
# Resolving the pool here instead would only re-create the fault in a new place:
# the same cluster fact, held in two skills, updated in one.
#
# Writes <run-dir>/run.env (resolved values, NON-SECRET) and prints a confirm
# block for the user.
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/verdict.sh
. "$SELF_DIR/lib/verdict.sh"
# shellcheck source=lib/common.sh
. "$SELF_DIR/lib/common.sh"
cs_init

usage() {
  cat <<'USAGE'
preflight [options]
  --nodes N        node count (default 1)
  --owner USER     owner label (default $USER)
  --cp N           vCPU per VM (default 24 on a 1-node box, 8 per VM otherwise)
  --mem GI         RAM GiB per VM (default 64 on a 1-node box, 24 per VM otherwise)
  --disk GI        root disk GiB (default 200 on a 1-node box, 100 per VM otherwise)
  --subnet LABEL   force a subnet label instead of auto-selecting
  --expose MODE    metallb (default) | nodeport
  --index N        force the cubestack<N> index
  --harbor FQDN    Harbor endpoint (default harbor.isuanova.com)
  --minio-ep URL   MinIO endpoint for the offline fetch
  --external-ceph  mark the run as importing an external Ceph Provider
  --external-ceph-env FILE
                   the Provider's exported external-ceph.env (implies
                   --external-ceph). Checked for shape and for the four
                   variables the installer requires, then recorded in run.env
                   so `configure` picks it up without being told again. That
                   path stays in the run dir, never in the repo.
  --cephfs-mount-guide FILE
                   the Provider's CephFS Linux-host mount guide. OPTIONAL, and
                   it is what turns on the Step 7 host mount of the filesystem's
                   /models on every node. Only the FILE PATH is recorded — the
                   guide is parsed at mount time for its fsid, mon and CephX
                   key, so no credential from it is ever copied into the run dir,
                   the values file or this repo.
  --harbor-ro-values FILE
                   a Harbor robot account with pull on suanova-private, suanova
                   and mirrors, as KEY='value' lines (HARBOR_RO_USER,
                   HARBOR_RO_PW). REQUIRED unless --no-operator: Step 7 turns the
                   k8s box into a cubestack box and pulls the operator chart from
                   Harbor OCI. Checked for shape here, at Step 0, while the user
                   is still in the room — a malformed credential found at Step 7
                   would fail a run that has already spent a full deploy. Only
                   the FILE PATH is recorded. Write it BEFORE running preflight.
  --no-operator    build only a k8s box: skip the Step 7 cubestack-box install
                   (cubestack-operator + the CubeStackCluster CR). The run then
                   ends at verify, with a verified k8s box and no platform.
                   Off by default.
  --run ID         pin the run id instead of deriving it from the target
                   (default: cubestack<N>, the resolved target). Every other
                   script takes the same flag; pass it on, or two installs
                   running at the same time will share state.
  -h, --help       this text
USAGE
}

NODES=1
OWNER="${USER:-$(id -un)}"
# Shape is resolved AFTER the argument loop, because its default depends on NODES
# (see "shape defaults" below). Empty here means "the caller did not say".
CP=""
MEM_GI=""
DISK_GI=""
SUBNET=""
# LoadBalancer (MetalLB) is the DEFAULT. MetalLB is a required component of a box
# this skill builds, and it is not a component toggle: it is gated by this global
# expose mode, and nodeport mode makes the installer 自动关闭 it. Leaving nodeport
# as the default therefore produced clusters with no metallb-system and no error
# anywhere - the failure was invisible. `--expose nodeport` remains an explicit
# opt-out, and `verify` does not demand MetalLB on a run that asked for it.
EXPOSE="metallb"
INDEX=""
HARBOR="$CS_HARBOR_DEFAULT"
MINIO_EP=""
EXTERNAL_CEPH=0
EXTERNAL_CEPH_ENV=""
CEPHFS_GUIDE=""
OPERATOR=1
HARBOR_RO_VALUES=""
RUN_ID=""

while [ $# -gt 0 ]; do
  case "$1" in
    --nodes) cs_need_val "$@";   NODES="${2:-}"; shift 2 ;;
    --owner) cs_need_val "$@";   OWNER="${2:-}"; shift 2 ;;
    --cp) cs_need_val "$@";      CP="${2:-}"; shift 2 ;;
    --mem) cs_need_val "$@";     MEM_GI="${2:-}"; shift 2 ;;
    --disk) cs_need_val "$@";    DISK_GI="${2:-}"; shift 2 ;;
    --subnet) cs_need_val "$@";  SUBNET="${2:-}"; shift 2 ;;
    --expose) cs_need_val "$@";  EXPOSE="${2:-}"; shift 2 ;;
    --index) cs_need_val "$@";   INDEX="${2:-}"; shift 2 ;;
    --harbor) cs_need_val "$@";  HARBOR="${2:-}"; shift 2 ;;
    --minio-ep) cs_need_val "$@"; MINIO_EP="${2:-}"; shift 2 ;;
    --external-ceph) EXTERNAL_CEPH=1; shift ;;
    --external-ceph-env) cs_need_val "$@"; EXTERNAL_CEPH_ENV="${2:-}"; shift 2 ;;
    --cephfs-mount-guide) cs_need_val "$@"; CEPHFS_GUIDE="${2:-}"; shift 2 ;;
    --harbor-ro-values) cs_need_val "$@";   HARBOR_RO_VALUES="${2:-}"; shift 2 ;;
    --no-operator)        OPERATOR=0; shift ;;
    --run) cs_need_val "$@";     RUN_ID="${2:-}"; shift 2 ;;
    -h|--help) usage; cs_ok "help=1" ;;
    *) cs_usage_fail "unknown argument: $1" ;;
  esac
done

# --- shape defaults ---------------------------------------------------------
# The default shape depends on the NODE COUNT, because a 1-node box is a
# different machine from a member of a multi-node one. A single node carries the
# control plane, the worker load AND every addon on the same VM - Rook/Ceph, the
# in-cluster registry, MetalLB, and (on a cubestack box) five platform components
# - where a multi-node box spreads them. The flat 8 vCPU / 24 GiB default was
# sized for the multi-node case and left the 1-node box as the tightest shape
# this skill builds.
#
# Empty means "the caller did not say", which is exactly what lets an explicit
# --cp/--mem/--disk win: the flag fills the variable and the default is skipped.
# This runs BEFORE the validation below and before the capacity filter, which is
# what the shape actually gates - a default the nodes cannot host has to fail
# here, at Step 0, naming the numbers rather than halfway through a deploy.
if [ "$NODES" -eq 1 ]; then
  CP="${CP:-24}"; MEM_GI="${MEM_GI:-64}"; DISK_GI="${DISK_GI:-200}"
else
  CP="${CP:-8}"; MEM_GI="${MEM_GI:-24}"; DISK_GI="${DISK_GI:-100}"
fi

for v in NODES CP MEM_GI DISK_GI; do
  eval "n=\${$v}"
  cs_kv_nonnumeric "$n" && cs_usage_fail "$v must be a positive integer (got '$n')"
  [ "$n" -gt 0 ] || cs_usage_fail "$v must be greater than zero"
done
case "$EXPOSE" in nodeport|metallb) ;; *) cs_usage_fail "--expose must be nodeport or metallb" ;; esac
# Metallic mode needs no pool here any more: the range is not chosen at Step 0,
# it is CLAIMED from the host's cubestack-ipam at Step 1b (reserve-vips), which
# is the only way to be sure MetalLB can never be handed an address a VM already
# holds. `configure` refuses the run if Step 1b never happened, and `verify`
# asserts the pool that ends up on the cluster is the block that was reserved —
# so a missed Step 1b is caught in two places, neither of them here.

# Passing the Provider's env file IS an external Ceph import, so the flag is
# derived rather than required - a caller cannot ask for the official path and
# forget to ask for the import, which would silently install no Ceph at all.
#
# Validated here as well as in configure. Both are local, cheap, and read-only;
# catching a malformed Provider export at Step 0 costs one answer, catching it
# at Step 4 costs a resolved run.
if [ -n "$EXTERNAL_CEPH_ENV" ]; then
  EXTERNAL_CEPH=1
  cs_ceph_env_lint "$EXTERNAL_CEPH_ENV"
fi

# The host-mount guide is parsed for a live CephX key, so it is checked HERE,
# at Step 0, while the user is still in the room — not at Step 7, where a
# malformed guide would fail a run that has already spent a full deploy. The
# lint reports field names and counts only, never content.
#
# The mount is a host-level read of the Provider's own filesystem and is
# orthogonal to the Ceph import: a run can import external Ceph and still not
# want /models on the nodes, and a guide on its own is not enough to import one
# (that needs the env file). They are therefore checked independently, and this
# one does NOT imply --external-ceph.
if [ -n "$CEPHFS_GUIDE" ]; then
  cs_cephfs_guide_lint "$CEPHFS_GUIDE"
fi

# The Harbor robot credential is what Step 7 installs the operator with, and it
# is checked HERE for the same reason as the two above: a malformed credential
# discovered at Step 7 fails a run that has already spent a full deploy, and this
# check is local, cheap and read-only. Reports key NAMES only, never content.
#
# The credential FILE IS the switch — passing it turns the platform step back on
# even next to --no-operator, because asking for the credential is asking for the
# step. The reverse is refused loudly rather than resolved by a rule the user
# cannot see: a bare `--no-operator` must be how you say "no operator".
if [ -n "$HARBOR_RO_VALUES" ]; then
  OPERATOR=1
  cs_values_lint "$HARBOR_RO_VALUES" HARBOR_RO_USER HARBOR_RO_PW
fi
if [ "$OPERATOR" = "1" ] && [ -z "$HARBOR_RO_VALUES" ]; then
  cs_usage_fail "--harbor-ro-values FILE is required unless --no-operator: Step 7 installs the platform operator by default and needs a Harbor robot credential (Write the file before running preflight)"
fi

# The budget is consumed AFTER the run id is known (below), so preflight's
# attempt counter lands in the run dir it actually belongs to. Consuming it here
# would charge every run's preflight to `runs/default/attempts`.
cs_kubeconfig_guard

# --- subnet -----------------------------------------------------------------
# Deterministic: the subnet with the most nodes whose allocatable CPU/RAM can
# host the requested shape. Ties break on the lexicographically lowest label.
if [ -z "$SUBNET" ]; then
  NODE_ROWS="$(kubectl get nodes \
    -o custom-columns='NAME:.metadata.name,SUBNET:.metadata.labels.kubevirt\.io/subnet,CPU:.status.allocatable.cpu,MEM:.status.allocatable.memory' \
    --no-headers 2>/dev/null)"
  SUBNET="$(printf '%s\n' "$NODE_ROWS" | awk -v cp="$CP" -v mem="$MEM_GI" '
    function togi(s){ if(s~/Ti$/){sub(/Ti$/,"",s);return s*1024}
                     if(s~/Gi$/){sub(/Gi$/,"",s);return s+0}
                     if(s~/Mi$/){sub(/Mi$/,"",s);return s/1024}
                     if(s~/Ki$/){sub(/Ki$/,"",s);return s/1048576}
                     return s/1073741824 }
    function toc(s){ if(s~/m$/){sub(/m$/,"",s);return s/1000} return s+0 }
    { if ($2=="" || $2=="<none>") next
      if (toc($3)>=cp && togi($4)>=mem) good[$2]++ }
    END { best=""; bestn=-1
          for (s in good)
            if (good[s]>bestn || (good[s]==bestn && (best=="" || s<best))) { bestn=good[s]; best=s }
          if (best!="") print best }')"
  if [ -z "$SUBNET" ]; then
    cs_fail E_SUBNET_UNRESOLVED "cp=$CP" "mem=${MEM_GI}Gi" recover=stop-report:admin \
      hint="no node carries a kubevirt.io/subnet label with room for the requested shape"
  fi
fi

# --- pool vs subnet ---------------------------------------------------------
# The default pool is a literal on 10.66.3.0/24. On any other subnet it is
# off-L2: MetalLB never announces it, the registry VIP is unreachable and every
# node pull fails - with nothing in the install saying why. The subnet label
# carries the network (10-66-3-0), which is enough to catch that HERE, at Step 0,
# The off-subnet check that used to live here has MOVED to `reserve-vips`. It
# could only ever compare the pool against the subnet once the pool existed, and
# at Step 0 it does not: the addresses are claimed from the host's ledger at Step
# 1b. Doing it there also catches the case this check could never see — the host
# offering a pool on a subnet the box's nodes are not on, which is off-L2, so
# MetalLB never announces and every node pull fails with nothing naming the cause.

# --- free index -------------------------------------------------------------
if [ -z "$INDEX" ]; then
  USED_MAX="$(kubectl -n "$CS_NS" get vm,virtualmachinepool -o name 2>/dev/null \
              | sed 's|^.*/||' | grep -E '^cubestack[0-9]+$' \
              | sed 's/^cubestack//' | sort -n | tail -1)"
  cs_kv_nonnumeric "${USED_MAX:-}" && USED_MAX=0
  INDEX=$((USED_MAX + 1))
fi

# --- naming -----------------------------------------------------------------
if [ "$NODES" -eq 1 ]; then
  POOL=""
  VM_NAMES="cubestack${INDEX}"
else
  POOL="cubestack${INDEX}"
  VM_NAMES=""
  i=0
  while [ "$i" -lt "$NODES" ]; do
    VM_NAMES="${VM_NAMES}${VM_NAMES:+,}cubestack${INDEX}-${i}"
    i=$((i + 1))
  done
fi

# --- run id -----------------------------------------------------------------
# The run id IS the target: `cubestack<N>`. That single choice gives the run a
# stable identity without giving it a shared one —
#
#   * re-running preflight for the same target is a cheap re-read of the same
#     run dir (run.env, stamps, attempt counters), which is what "re-run it the
#     instant the user changes an answer" depends on; and
#   * two installs running at the same time resolve DIFFERENT indices (the free
#     index is `first free cubestack<N>` across VMs and pools), so they get
#     different run dirs and, from that, different bootstrap pod names.
#
# Changing an answer that does not change the target (node count, shape, expose
# mode) keeps the same run dir; changing which cluster you are installing does
# not, and should not. --run pins an explicit id instead (that is how a run is
# resumed by name); CUBESTACK_RUN in the environment wins over both.
# CUBESTACK_RUN wins over --run: it is how a caller pins the whole session to one
# run, and a pin that could be overridden by a stray flag would be no pin at all.
if [ -n "$RUN_ID" ] && [ -z "${CUBESTACK_RUN:-}" ]; then
  cs_run_opt "$RUN_ID"
elif [ -z "${CUBESTACK_RUN:-}" ]; then
  export CUBESTACK_RUN="$HOME/.cubestack/runs/cubestack${INDEX}"
fi
RUN_ID="$(basename "$(cs_run_dir)")"
mkdir -p "$(cs_run_dir)/verdict" "$(cs_run_dir)/logs" 2>/dev/null || true

cs_budget_guard

# run.env is MERGED, not truncated. Truncating destroys the keys that later steps
# write — POD_NAME (pod-up), METALLB_REQUESTED (configure), EXTERNAL_CEPH_ENV and
# EXTERNAL_CEPH_ENV_DEST (configure, which `deploy` re-checks before launching) —
# so a preflight re-run partway through a healthy run used to silently disable
# preconditions the later steps then failed on, or worse, did not. It would also
# wipe a Step 1b VIP reservation.
#
# The keys below are the ones preflight OWNS; only those are replaced, so
# re-resolving an answer changes exactly what it should and nothing else.
cs_run_env_put \
  "RUN_ID=$(cs_q "$RUN_ID")" \
  "NODES=$(cs_q "$NODES")" \
  "OWNER=$(cs_q "$OWNER")" \
  "CP=$(cs_q "$CP")" \
  "MEM_GI=$(cs_q "$MEM_GI")" \
  "DISK_GI=$(cs_q "$DISK_GI")" \
  "SUBNET=$(cs_q "$SUBNET")" \
  "EXPOSE=$(cs_q "$EXPOSE")" \
  "POOL_RANGE=$(cs_q "")" \
  "INDEX=$(cs_q "$INDEX")" \
  "HARBOR=$(cs_q "$HARBOR")" \
  "MINIO_EP=$(cs_q "$MINIO_EP")" \
  "EXTERNAL_CEPH=$(cs_q "$EXTERNAL_CEPH")" \
  "EXTERNAL_CEPH_ENV_FILE=$(cs_q "$EXTERNAL_CEPH_ENV")" \
  "CEPHFS_MOUNT=$(cs_q "$([ -n "$CEPHFS_GUIDE" ] && echo 1 || echo 0)")" \
  "CEPHFS_GUIDE_FILE=$(cs_q "$CEPHFS_GUIDE")" \
  "OPERATOR_ENABLED=$(cs_q "$OPERATOR")" \
  "HARBOR_RO_VALUES_FILE=$(cs_q "$HARBOR_RO_VALUES")" \
  "POOL=$(cs_q "$POOL")" \
  "VM_NAMES=$(cs_q "$VM_NAMES")"

# POOL_RANGE is deliberately reset to empty: it is no longer a Step 0 answer but
# the block Step 1b reserves, and a stale range from a previous resolution would
# otherwise look like a live reservation to `configure`. It has to be WRITTEN
# (not merely omitted) so `reserve-vips` has a line to replace.

cat <<EOF
CONFIRM — resolved prerequisites (nothing has been created yet)
  nodes         $NODES
  VMs           $VM_NAMES${POOL:+   (VirtualMachinePool $POOL)}
  shape         ${CP} vCPU / ${MEM_GI} GiB RAM / ${DISK_GI} GiB root
  subnet        $SUBNET
  owner label   owner=$OWNER
  expose        $EXPOSE$([ "$EXPOSE" = "metallb" ] && echo "   (VIP block reserved at Step 1b from the host's IPAM; --count there sets how many)")
  Harbor        $HARBOR
  MinIO         ${MINIO_EP:-<not set — required before fetch-offline>}
  external Ceph $([ "$EXTERNAL_CEPH" = "1" ] && echo yes || echo no)${EXTERNAL_CEPH_ENV:+   (official import: $(basename "$EXTERNAL_CEPH_ENV"))}
  models mount  $([ -n "$CEPHFS_GUIDE" ] && echo "yes   ($(basename "$CEPHFS_GUIDE") -> /models on every node)" || echo "no    (Step 7 skips it)")
  building      $([ "$OPERATOR" = "1" ] && echo "cubestack box   (k8s box + cubestack-operator + the CubeStackCluster CR)" || echo "k8s box only    (--no-operator; the run ends at verify)")
  harbor robot  $([ "$OPERATOR" = "1" ] && echo "$(basename "$HARBOR_RO_VALUES")   (read at Step 7, never stored in the run dir)" || echo "-")

  run id        $RUN_ID        (--run $RUN_ID on every later step)
  run dir       $(cs_run_dir)
  pod name      $(cs_pod_name "$RUN_ID")   (unique to this run)

Secrets (SSH password, MinIO keys, Ceph keyrings) are NOT resolved here and are
never stored in the run dir — they arrive through the Write -> configure path.
EOF

cs_ok "run=$RUN_ID" "index=$INDEX" "nodes=$NODES" "subnet=$SUBNET" \
      "vms=$VM_NAMES" "ceph_env=$([ -n "$EXTERNAL_CEPH_ENV" ] && echo official || echo none)" \
      "models_mount=$([ -n "$CEPHFS_GUIDE" ] && echo on || echo off)" \
      "operator=$([ "$OPERATOR" = "1" ] && echo on || echo off)" \
      "harbor_ro=$([ -n "$HARBOR_RO_VALUES" ] && echo 1 || echo 0)" \
      "run_dir=$(cs_run_dir)"
